<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <!-- DEC-093: runtime packs are signature-verified, not lock-file pinned. -->
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SporAkademi.IntegrationTests" />
    <InternalsVisibleTo Include="SporAkademi.ArchitectureTests" />
    <InternalsVisibleTo Include="SporAkademi.Application.UnitTests" />
    <InternalsVisibleTo Include="SporAkademi.Domain.UnitTests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>
</Project>
