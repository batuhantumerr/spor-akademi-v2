{
  "name": "spor-akademi-parent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:api": "openapi-typescript openapi/spor-akademi.json --output src/api/schema.gen.ts",
    "predev": "npm run generate:api",
    "dev": "vite",
    "start": "npm run dev",
    "prebuild": "npm run generate:api",
    "build": "vite build",
    "preview": "vite preview",
    "pretypecheck": "npm run generate:api",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p sw/tsconfig.json",
    "pretest": "npm run generate:api",
    "test": "vitest run",
    "prelint": "npm run generate:api",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@microsoft/signalr": "10.0.11",
    "@tanstack/react-query": "5.106.0",
    "lucide-react": "1.69.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    },
    "eslint": {
      "minimatch": "11.0.3"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.3"
    },
    "@isaacs/nonrecursive-glob-match": "1.0.3"
  }
}
