{
  "name": "spor-akademi-admin",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "generate:api": "ng-openapi-gen --config ng-openapi-gen.json",
    "prestart": "npm run generate:api",
    "start": "ng serve --proxy-config proxy.conf.json",
    "prebuild": "npm run generate:api",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run generate:api",
    "test": "ng test --watch=false",
    "prelint": "npm run generate:api",
    "lint": "ng lint",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "private": true,
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.0.0",
    "ng-openapi-gen": "1.1.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=26.0.0 <27"
  }
}
