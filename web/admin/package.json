{
  "name": "spor-akademi-admin",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "generate:api": "ng-openapi-gen --config ng-openapi-gen.json",
    "prestart": "npm run generate:api",
    "start": "ng serve --proxy-config proxy.conf.json",
    "prebuild": "npm run generate:api",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run generate:api",
    "test": "ng test --watch=false",
    "e2e": "bash ../../scripts/e2e.sh",
    "prelint": "npm run generate:api",
    "lint": "ng lint",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "private": true,
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "@angular/cdk": "22.2.4",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@lucide/angular": "1.64.0",
    "@microsoft/signalr": "10.0.11",
    "echarts": "6.1.0",
    "ngx-echarts": "22.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.0.0",
    "ng-openapi-gen": "1.1.0",
    "postcss": "8.5.32",
    "prettier": "^3.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "overrides": {
    "playwright-core": "1.64.1",
    "minimatch": "11.0.3",
    "@isaacs/nonrecursive-glob-match": "1.0.3"
  }
}
