# Copy to .env and replace every value. Passwords: letters and digits only (openssl rand -hex 24).
# .env is git-ignored; never commit it.
POSTGRES_PASSWORD=change-me
SPOR_AKADEMI_MIGRATOR_PASSWORD=change-me
SPOR_AKADEMI_APP_PASSWORD=change-me
JWT_SIGNING_KEY=change-me-to-64-hex-chars
# Optional Valkey cache (docker compose --profile cache). Without it the API caches in memory only and
# nothing else needs these keys; bash scripts/setup-env.sh appends them to an existing .env.
VALKEY_PASSWORD=change-me
VALKEY_HOST_PORT=56379
# Optional Mailpit e-mail catcher (docker compose --profile mail): host ports of its SMTP server and web UI.
MAILPIT_SMTP_HOST_PORT=51025
MAILPIT_UI_HOST_PORT=58025
POSTGRES_HOST_PORT=55432
SEQ_HOST_PORT=5341
# Optional document storage (SeaweedFS, docker compose --profile storage, DEC-320/DEC-326). Without it the API runs
# with documents unavailable and nothing else needs these keys; bash scripts/setup-env.sh appends them to an existing .env.
STORAGE_ACCESS_KEY=change-me
STORAGE_SECRET_KEY=change-me
STORAGE_HOST_PORT=58333
STORAGE_BUCKET=spor-akademi-documents
# Optional local observability (docker compose --profile observability, DEC-554): OTLP receiver (Jaeger), Jaeger UI,
# Prometheus (alerts) and Perses (dashboards) host ports. bash scripts/setup-env.sh appends them to an existing .env.
OTLP_GRPC_HOST_PORT=54317
OTLP_HTTP_HOST_PORT=54318
JAEGER_UI_HOST_PORT=56686
PROMETHEUS_HOST_PORT=57090
PERSES_HOST_PORT=58080
# First Platform Admin, created at API start when none exists; the password must be changed at first login.
PLATFORM_ADMIN_EMAIL=platform@spor-akademi.local
PLATFORM_ADMIN_PASSWORD=change-me
# Optional: password of every demo account created by scripts/seed-demo.sh (at least 12 characters).
# When unset the seeder generates one and prints it once.
# DEMO_PASSWORD=
