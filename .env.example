# Copy to .env and replace every value. Passwords: letters and digits only (openssl rand -hex 24).
# .env is git-ignored; never commit it.
POSTGRES_PASSWORD=change-me
SPOR_AKADEMI_MIGRATOR_PASSWORD=change-me
SPOR_AKADEMI_APP_PASSWORD=change-me
JWT_SIGNING_KEY=change-me-to-64-hex-chars
# Valkey (distributed cache, optional for the API: without it the cache is in memory only).
VALKEY_PASSWORD=change-me
VALKEY_HOST_PORT=56379
POSTGRES_HOST_PORT=55432
SEQ_HOST_PORT=5341
# First Platform Admin, created at API start when none exists; the password must be changed at first login.
PLATFORM_ADMIN_EMAIL=platform@spor-akademi.local
PLATFORM_ADMIN_PASSWORD=change-me
# Optional: password of every demo account created by scripts/seed-demo.sh (at least 10 characters).
# When unset the seeder generates one and prints it once.
# DEMO_PASSWORD=
